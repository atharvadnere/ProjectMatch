# OpenRouter API key (server-side only, never exposed to client)
OPENROUTER_API_KEY=your_text_here

# OpenRouter model id. Use a free model, e.g.:
# minimax/minimax-m3:free
# z-ai/glm-5.2:free
# nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL=minimax/minimax-m3:free

# Optional site identification sent to OpenRouter
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=ProjectMatch
